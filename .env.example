# ---------------------------------------------------------------------------
# Sprout Event SOA Tool — environment configuration
# Copy this file to `.env` and fill in the values. Nothing here is committed.
# The app runs without any of these set (integrations degrade gracefully to a
# "dry-run" mode that logs what WOULD have happened), so you can develop and
# demo before wiring live credentials.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3000
# Public base URL of this app (used to build absolute links in emails / webhooks)
PUBLIC_BASE_URL=http://localhost:3000

# --- SMTP / email (nodemailer) ---
# If unset, emails are written to ./outbox/*.eml instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sprout Events <events@sprout.ph>"
# Optional internal copy of every SOA that goes out
MAIL_BCC=events@sprout.ph

# --- HubSpot (private app token) ---
# Scopes needed: crm.objects.contacts.read/write, crm.objects.deals.read/write
HUBSPOT_TOKEN=
# Contact property internal names (verified against the Sprout portal).
# Registration data is written to CONTACTS, one per attendee.
HUBSPOT_EVENT_NAME_PROPERTY=event_name
HUBSPOT_REGISTRATION_TYPE_PROPERTY=event_registration_type
HUBSPOT_PAYMENT_STATUS_PROPERTY=event_payment_status
HUBSPOT_JOBTITLE_PROPERTY=jobtitle
# NOTE: event_payment_status only accepts "Paid" / "Pending" in the portal
# (a new registration is written as "Pending"). event_name is an enumeration —
# add "State of HR Summit 2026" as an option in HubSpot, or registrations with
# that value are rejected by the API.
# HubSpot pipeline / stage to file new event deals under (optional)
HUBSPOT_DEAL_PIPELINE=
HUBSPOT_DEAL_STAGE=

# --- Shopify ---
# Store domain that fronts the checkout (from the sample SOA)
SHOPIFY_STORE_DOMAIN=5zhckw-pf.myshopify.com
# Admin API access token — only needed for order-webhook verification + draft orders
SHOPIFY_ADMIN_TOKEN=
# Webhook HMAC shared secret (Shopify Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# --- Sales invoice request ---
# How to raise the "request for sales invoice" once payment lands.
# One of: email | webhook | none
INVOICE_REQUEST_MODE=email
INVOICE_REQUEST_EMAIL=finance@sprout.ph
INVOICE_REQUEST_WEBHOOK_URL=

# --- Persistence ---
# JSON file store location (simple, dependency-free). Swap for a DB later.
DATA_DIR=./data
